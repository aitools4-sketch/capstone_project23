SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-sb_secret-key
ALLOWED_ORIGINS=http://localhost:5173

# Optional — POST /api/scans returns 503 until at least one of these is set.
# DEHASHED_API_KEY=your-dehashed-api-key
# HIBP_API_KEY=your-hibp-v3-api-key

# Optional — GET /api/scans/{id}/insights returns 503 until this is set.
# ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional — the periodic breach-alert notifier logs a skip instead of
# emailing until this is set. Until a domain is verified in Resend, mail
# only actually delivers to the Resend account's own address.
# RESEND_API_KEY=your-resend-api-key
# RESEND_FROM_EMAIL=Breached <onboarding@resend.dev>

# How often the background re-scan worker checks for new breaches.
# NOTIFIER_INTERVAL_HOURS=24

# Optional — error tracking is off until this is set.
# SENTRY_DSN=your-sentry-project-dsn

# Optional — logs a warning once daily paid-API usage crosses these counts.
# DAILY_SEARCH_WARNING_THRESHOLD=200
# DAILY_INSIGHT_WARNING_THRESHOLD=100
